---
const pageTitle = "Pantry Notes"
import BaseLayout from "../layouts/BaseLayout.astro"
import Header from "../components/Header.astro"
import BlogPost from "../components/BlogPost.astro"
const allPosts = Object.values(import.meta.glob('./posts/*.md', {eager: true}))
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
	</head>
	<body>
		<BaseLayout pageTitle={pageTitle}>
		<ul>
			<!-- <li><a href="/posts/recipe1/">Smoked Pulled Pork</a></li>
			<li><a href="/posts/recipe2/">All-Purpose Chicken Seasoning</a></li> -->
			{allPosts.map((post: any) => <BlogPost url={post.url} title={post.frontmatter.title} />)}
		</ul>
		</BaseLayout>
	</body>
</html>
